# ---------------------------------------------------------------------------
# Campus Connect — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).
#
# Leave both variables empty to run the app in DEMO MODE: every screen renders
# with seeded sample data, no database required.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
# Supabase renamed "anon key" → "publishable key". Either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storage bucket that holds uploaded notes (created by supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_NOTE_BUCKET=notes

# Shown in the footer "view source" link.
NEXT_PUBLIC_GITHUB_URL=https://github.com/harshivkharya127-cyber/campus-connect